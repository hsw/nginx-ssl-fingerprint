
#
# JA3 module conf
#

ngx_addon_name=ngx_ssl_fingerprint_module

CORE_LIBS="$CORE_LIBS"
CORE_INCS="$CORE_INCS $ngx_addon_dir/src"

# defense-in-depth for non-nginx compile contexts (SAST, standalone-TU builds):
# in nginx builds this has no observable effect -- ngx_event_openssl.h already
# does "#define OPENSSL_SUPPRESS_DEPRECATED" (pulled via ngx_core.h) before any
# OpenSSL header. empty value: plain -DOPENSSL_SUPPRESS_DEPRECATED would define
# it as 1 and trip -Werror on macro redefinition against nginx's valueless define
CFLAGS="$CFLAGS -DOPENSSL_SUPPRESS_DEPRECATED="

if [ $HTTP != YES ]; then
  echo "$0: error: $ngx_addon_name requires the http module, do not use --without-http"
  exit 1
fi

if [ $HTTP_SSL != YES ]; then
  echo "$0: error: $ngx_addon_name requires --with-http_ssl_module"
  exit 1
fi

if [ $HTTP_V2 != YES ]; then
  echo "$0: error: $ngx_addon_name requires --with-http_v2_module"
  exit 1
fi

HTTP_MODULES="$HTTP_MODULES ngx_http_ssl_fingerprint_module"

stream_module=""

if [ $STREAM_SSL = YES ] && [ $STREAM != YES ]; then
  echo "$0: error: $ngx_addon_name requires static --with-stream when --with-stream_ssl_module is used (--with-stream=dynamic is not supported)"
  exit 1
fi

if [ $STREAM_SSL = YES ]; then
  echo "[+] ngx_stream_ssl_fingerprint_preread_module included"
  STREAM_MODULES="$STREAM_MODULES ngx_stream_ssl_fingerprint_preread_module"
  stream_module="$ngx_addon_dir/src/ngx_stream_ssl_fingerprint_preread_module.c"
else
  echo "[-] ngx_stream_ssl_fingerprint_preread_module will no be compiled"
fi

NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
  $ngx_addon_dir/src/nginx_ssl_fingerprint.c \
  $ngx_addon_dir/src/ngx_http_ssl_fingerprint_module.c \
  $stream_module"

have=NGX_JA3_FINGERPRING_MODULE  . auto/have

